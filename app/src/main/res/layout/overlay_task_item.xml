<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/overlay_card_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/overlay_task_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/overdue_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/overlay_task_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/overdue_accent"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/overlay_task_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="4"
        android:textColor="@color/overdue_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/overlay_key_points_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/overdue_key_points"
        android:textColor="@color/overdue_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/overlay_key_points"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/overlay_task_done_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/overdue_done_hint"
        android:textColor="@color/overdue_text_secondary"
        android:textSize="12sp"
        android:textStyle="italic" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/overlay_task_open"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overdue_open"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/overlay_task_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overdue_done"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
