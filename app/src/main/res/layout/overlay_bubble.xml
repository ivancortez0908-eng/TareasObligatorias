<?xml version="1.0" encoding="utf-8"?>
<!-- Minimized state of the overdue window: a draggable bubble with the number of overdue tasks. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="60dp"
    android:minHeight="60dp"
    android:background="@drawable/overlay_bubble_bg"
    android:contentDescription="@string/overdue_bubble_description"
    android:elevation="6dp">

    <TextView
        android:id="@+id/overlay_bubble_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="6dp"
        android:text="!"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
</FrameLayout>
